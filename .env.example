# ============================================
# AI Brain 环境变量模板
# 使用方式：复制本文件为 .env 并填写真实值
#   注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================

# ===== 数据库（PostgreSQL 16 + pgvector）=====
POSTGRES_USER=aibrain
POSTGRES_PASSWORD=aibrain
POSTGRES_DB=aibrain
# 应用运行时使用 asyncpg（异步驱动）
DATABASE_URL=postgresql+asyncpg://aibrain:aibrain@localhost:5432/aibrain

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 安全（【生产必填】替换为随机长字符串，如：openssl rand -hex 32）=====
JWT_SECRET_KEY=please-change-me-to-a-random-secret

# ===== AI：DeepSeek（LLM）【生产必填】=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== AI：Embedding（SiliconFlow BGE-M3）【生产必填】=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ===== AI：OCR（扫描版 PDF 文字提取，复用 SiliconFlow 同一 Key）=====
OCR_MODEL=deepseek-ai/DeepSeek-OCR

# ===== 应用（生产保持 false）=====
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
